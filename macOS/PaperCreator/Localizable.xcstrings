    },
    "Check every answer, allocation of credit, diagram, code listing and page. Compare difficulty and timing with authentic papers. Automated checks cannot replace a French NSI teacher." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifier chaque réponse, attribution de points, figure, extrait de code et page. Comparer la difficulté et la durée aux sujets authentiques. Les contrôles automatiques ne remplacent pas un enseignant de NSI."
          }
        }
      }
    },
