        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spécialité"
          }
        }
      }
    },
    "Three independent exercises: 18 technical points, plus 2 points for French. The practical component is not included." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trois exercices indépendants : 18 points techniques et 2 points pour la maîtrise de la langue. La partie pratique n’est pas incluse."
          }
        }
      }
    },
    "References and privacy" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Références et confidentialité"
          }
        }
      }
    },
    "Official sources are downloaded only with your permission. Generation uses Ollama on this Mac; no student answers are collected." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sources officielles sont téléchargées uniquement avec votre accord. La génération utilise Ollama sur ce Mac ; aucune réponse d’élève n’est collectée."
          }
        }
      }
    },
    "Prepare French references" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
