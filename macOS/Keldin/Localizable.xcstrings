      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Ollama a interrompu le téléchargement du modèle (code de sortie %@). Vérifiez Ollama, puis réessayez." } } }
    },
    "The operation stopped (exit code %@). Try again." : {
