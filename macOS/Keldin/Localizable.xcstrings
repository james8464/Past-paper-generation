    },
    "Couldn't complete the action" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’action n’a pas pu aboutir"
          }
        }
      }
    },
    "These suggestions concern available memory. The models have not passed a complete paper-quality review. Results may vary with another model or quantisation." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces suggestions tiennent compte de la mémoire disponible. Les sujets produits par ces modèles n’ont pas encore passé un contrôle de qualité complet. Les résultats peuvent varier avec un autre modèle ou une autre quantification."
          }
        }
      }
    },
