    },
    "Access to this PDF couldn't be saved. Choose the file again." : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "L’autorisation d’accès à ce PDF n’a pas pu être enregistrée. Choisissez à nouveau le fichier." } } }
    },
    "Some older history items couldn't be removed. They remain listed. Keldin will retry when history is saved or Keldin is reopened." : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Certains anciens éléments de l’historique n’ont pas pu être supprimés. Ils restent affichés. Keldin réessaiera lors du prochain enregistrement de l’historique ou au redémarrage." } } }
    },
    "Some older history items couldn't be removed. They remain listed in History until cleanup succeeds." : {
