    "Keldin creates unofficial practice papers and mark schemes. Check the selected subject's generation details before starting. Preview mode checks layout without calling AI. Every paper needs human review." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keldin crée des sujets d’entraînement et des corrigés non officiels. Avant de commencer, consultez les indications du générateur choisi. Le mode aperçu vérifie la mise en page sans appeler d’IA. Chaque sujet doit être relu."
          }
        }
      }
    },
    "Keldin context" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contexte de Keldin"
          }
        }
      }
    },
