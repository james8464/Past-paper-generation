    },
    "Keyboard Shortcuts" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raccourcis clavier"
          }
        }
      }
    },
    "Choose a subject" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisir une matière"
          }
        }
      }
    },
    "Choose the subject and assessment you want to practise." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez la matière et l’épreuve à travailler."
          }
        }
      }
    },
    "Use the recommended model" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser le modèle recommandé"
          }
        }
      }
    },
    "Keldin recommends %@ for this Mac; other models can produce different results." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keldin recommande %@ pour ce Mac. D’autres modèles peuvent produire des résultats différents."
          }
        }
      }
    },
    "Create both documents" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créer les deux documents"
          }
        }
      }
    },
    "The question paper and mark scheme are saved together." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sujet et le corrigé sont enregistrés ensemble."
          }
        }
      }
    },
    "Preview and review" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher et vérifier"
          }
        }
      }
    },
    "Inspect every generated PDF in Documents and return to any configuration from History." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez chaque PDF dans Documents. L’Historique permet de retrouver une configuration."
          }
        }
      }
    },
    "Choose a generator" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisir un générateur"
          }
        }
      }
    },
    "Select a supported subject and exam board in the sidebar." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez une matière et un organisme d’examen disponibles dans la barre latérale."
          }
        }
      }
    },
    "Prepare AI" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préparer l’IA"
          }
        }
      }
    },
    "For local generation, install Ollama and use the model recommended for this Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour la génération locale assistée par IA, installez Ollama et utilisez le modèle recommandé pour ce Mac."
          }
        }
      }
    },
    "Configure the paper" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurer le sujet"
          }
        }
      }
    },
    "Choose a paper, output folder, and provider. Leave preview mode off for new AI-written questions." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez l’épreuve, le dossier de sortie et le fournisseur. Désactivez le mode aperçu pour obtenir de nouvelles questions rédigées par IA."
          }
        }
      }
    },
    "Create and review" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créer et vérifier"
          }
        }
      }
    },
    "Create the paper, then inspect both PDFs and the quality evidence before using them." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez le sujet, puis vérifiez les deux PDF et les éléments de contrôle avant de les utiliser."
          }
        }
      }
    },
    "Unofficial practice material" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Documents d’entraînement non officiels"
          }
        }
      }
    },
    "Generated work is not affiliated with or endorsed by an exam board. Always review it before giving it to students." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les documents générés ne sont ni affiliés ni approuvés par un organisme d’examen. Relisez-les avant de les donner à des élèves."
          }
        }
      }
    },
    "AI Settings identifies the recommendation and warns when another model is selected." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages IA indiquent le modèle recommandé et signalent la sélection d’un autre modèle."
          }
        }
      }
    },
    "Results may vary with other models" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les résultats peuvent varier avec d’autres modèles"
          }
        }
      }
    },
    "Checks and limits" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contrôles et limites"
          }
        }
      }
    },
    "Keldin checks structured output, marks, command words, topics and assessment objectives. Invalid output can stop generation." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keldin vérifie le format des résultats, les points, les consignes, les thèmes et les objectifs d’évaluation. Un résultat non valide peut interrompre la génération."
          }
        }
      }
    },
    "With the default local Ollama server, prompts and generated content stay on this Mac." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec le serveur local Ollama utilisé par défaut, les instructions et le contenu généré restent sur ce Mac."
          }
        }
      }
    },
    "Difficulty checks compare task features with past papers. Each valid choice of questions is checked separately, as is every printed alternative. Completion times are estimates; no learner timings have been measured." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les contrôles de difficulté comparent les caractéristiques des questions à celles des annales. Chaque choix de questions autorisé est vérifié séparément, de même que chaque question alternative imprimée. Les durées sont des estimations ; aucun temps de travail d’élève n’a été mesuré."
          }
        }
      }
    },
    "Question review, answer checking and difficulty checks use separate prompts and evidence. They may use the same model, so they are not independent model opinions." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La relecture des questions, la vérification des réponses et les contrôles de difficulté utilisent des instructions et des éléments distincts. Ils peuvent employer le même modèle et ne constituent donc pas des avis de modèles indépendants."
          }
        }
      }
    },
    "Completed papers are checked for changes in their expected task mix. These limits are engineering rules, not measured confidence intervals. No examiner approval or learner calibration is claimed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sujets terminés sont contrôlés pour repérer des écarts dans la répartition attendue des questions. Ces limites sont des règles techniques, pas des intervalles de confiance mesurés. Aucune validation par un examinateur ni aucun étalonnage auprès d’élèves ne sont revendiqués."
          }
        }
      }
    },
    "Memory guidance" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conseils sur la mémoire"
          }
        }
      }
    },
    "16 GB or more: gemma4:12b is the configured local suggestion." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À partir de 16 Go : gemma4:12b est le modèle local suggéré dans la configuration."
          }
        }
      }
    },
    "Below 16 GB: qwen2.5:7b is the smaller local suggestion. Memory use still depends on other apps and context." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En dessous de 16 Go : qwen2.5:7b est le modèle local plus petit qui est suggéré. La mémoire utilisée dépend aussi des autres applications et du contexte."
          }
        }
      }
    },
    "Keep memory-heavy apps closed during generation. Model download size is not the model’s complete runtime memory requirement." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermez les applications gourmandes en mémoire pendant la génération. La taille du téléchargement du modèle ne représente pas toute la mémoire nécessaire à son exécution."
          }
        }
      }
    },
    "The workspace keeps the paper configuration, create action, recent files, and release gates visible together." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’espace de travail regroupe la configuration, l’action de création, les fichiers récents et les contrôles avant publication."
          }
        }
      }
    },
    "Select subject and board" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisir la matière et l’organisme"
          }
        }
      }
    },
    "Only implemented generators appear. Their papers come from the canonical generator registry." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les générateurs disponibles apparaissent. Leurs épreuves proviennent du registre central des générateurs."
          }
        }
      }
    },
    "Choose the assessment" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisir l’épreuve"
          }
        }
      }
    },
    "Select a full paper or, where available, Topic Practice. The blueprint locks marks, command words, syllabus scope, and expected demand." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une épreuve complète ou, si elle est disponible, une série par thème. Le plan fixe les points, les consignes, le programme couvert et l’exigence attendue."
          }
        }
      }
    },
    "Check the provider" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifier le fournisseur"
          }
        }
      }
    },
    "Ollama must be running and the selected model must be installed. Hosted providers require a key and explicit consent." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama doit être lancé et le modèle sélectionné doit être installé. Les fournisseurs en ligne exigent une clé et votre accord explicite."
          }
        }
      }
    },
    "Choose a folder" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisir un dossier"
          }
        }
      }
    },
    "The question paper, mark scheme, assessment evidence, and package manifest are published together only after validation passes." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sujet, le corrigé, les éléments de contrôle et le manifeste sont publiés ensemble uniquement après validation."
          }
        }
      }
    },
    "Create the assessment" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créer l’épreuve"
          }
        }
      }
    },
    "Generation can take several minutes. Progress and the estimated time remain visible, and Command-Period cancels safely." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La génération peut prendre plusieurs minutes. La progression et la durée estimée restent visibles. Commande-Point permet d’annuler sans publier de document incomplet."
          }
        }
      }
    },
    "Preview and reuse" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afficher et réutiliser"
          }
        }
      }
    },
    "Documents opens every generated PDF in the app. History can duplicate a setup or create a new form with a new seed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Documents ouvre chaque PDF généré dans l’application. L’Historique permet de dupliquer une configuration ou de créer un autre sujet avec une nouvelle graine."
          }
        }
      }
    },
    "Preview mode is not a finished paper" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode aperçu ne produit pas un sujet final"
          }
        }
      }
    },
    "Create a layout preview only when checking document geometry. Preview content has no live item-review or originality evidence, and missing saved evidence is reported as unknown rather than passed." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez l’aperçu pour vérifier la géométrie du document. Son contenu n’a pas de preuve de revue des questions ni d’originalité issue d’une génération réelle. Les preuves absentes sont signalées comme inconnues, sans être considérées comme validées."
          }
        }
      }
    },
    "Use Topic Practice for focused revision" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser les séries par thème pour réviser"
          }
        }
      }
    },
    "A topic bank is matched to reviewed topic and task-operation records, not full-paper AO percentages. Sparse, mixed or missing source evidence is shown as Insufficient. A bank may be built after structural, correctness, source-content and item-review checks pass while calibration remains insufficient; this is not a calibration pass or external qualification. Data structures, databases, and functional programming are available for AQA Computer Science." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une banque thématique est comparée aux thèmes et opérations des questions relues, pas aux pourcentages par objectif d’une épreuve complète. Des sources rares, hétérogènes ou absentes entraînent le statut Insuffisant. La banque peut être créée après les contrôles de structure, d’exactitude, de contenu des sources et de revue des questions, même si son étalonnage reste insuffisant. Cela ne valide ni son étalonnage ni une qualification externe. Les structures de données, les bases de données et la programmation fonctionnelle sont disponibles pour AQA Computer Science."
          }
        }
      }
    },
    "Question and mark-scheme review" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifier les questions et le corrigé"
          }
        }
      }
    },
    "Confirm each command word matches the marks and the expected depth of response." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez que chaque consigne correspond au nombre de points et au développement attendu."
          }
        }
      }
    },
    "Check every fact, calculation, chart label, unit, source reference, distractor, and correct answer." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez les faits, les calculs, les légendes, les unités, les références, les réponses proposées dans les QCM et les réponses correctes."
          }
        }
      }
    },
    "Ensure the mark scheme awards every available mark, uses specific creditworthy points, and supports consistent marking." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez que le corrigé permet d’attribuer tous les points, donne des critères précis et permet une correction cohérente."
          }
        }
      }
    },
    "For essays, look for accurate knowledge, contextual application, developed analysis, balanced evaluation, and a supported judgement." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les réponses rédigées, vérifiez les connaissances, leur application au contexte, le développement de l’analyse, l’évaluation des différents arguments et la justification du jugement."
          }
        }
      }
    },
    "Layout review" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifier la mise en page"
          }
        }
      }
    },
    "Check page size, cover hierarchy, fonts, margins, question numbering, mark placement, continuation space, tables, diagrams, and page breaks." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez le format des pages, la couverture, les polices, les marges, la numérotation, l’emplacement des points, l’espace de réponse, les tableaux, les schémas et les sauts de page."
          }
        }
      }
    },
    "Use Recent Documents to open both PDFs. Quality review reports blueprint, originality, visual, and difficulty evidence separately." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez les deux PDF depuis les documents récents. Le contrôle qualité présente séparément les éléments relatifs au plan, à l’originalité, à la mise en page et à la difficulté."
          }
        }
      }
    },
    "Difficulty is intended demand until the exact form has enough independently reviewed examiner, learner-response, and timing evidence; the app does not claim psychometric equivalence." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La difficulté indiquée reste une exigence visée tant que le sujet exact ne dispose pas d’éléments suffisants provenant d’examinateurs, de réponses d’élèves et de durées observées, revus indépendamment. L’application ne revendique aucune équivalence psychométrique."
          }
        }
      }
    },
    "The French workspace shows the exam context, local references, enlarged-print option and review limits." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’espace français présente le contexte de l’épreuve, les références locales, l’option de caractères agrandis et les limites de la revue."
          }
        }
      }
    },
    "Work through the paper" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Résoudre le sujet"
          }
        }
      }
    },
    "Check the syllabus content, reasoning steps, calculations and proposed marks against official papers. Automated checks do not establish equal difficulty." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparez le programme couvert, les étapes de raisonnement, les calculs et les points proposés aux sujets officiels. Les contrôles automatiques ne prouvent pas une difficulté équivalente."
          }
        }
      }
    },
    "Keep the limits visible" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserver les limites indiquées"
          }
        }
      }
    },
    "Difficulty and completion time are uncalibrated. An optional teacher-review record can be attached to the exact artifact hashes; the app does not invent one." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La difficulté et la durée de réalisation ne sont pas étalonnées. Une revue enseignante facultative peut être rattachée aux empreintes exactes des fichiers. L’application n’en invente pas."
          }
        }
      }
    },
    "Ollama generation stays on this Mac and does not require an account." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La génération avec Ollama reste sur ce Mac et ne nécessite pas de compte."
          }
        }
      }
    },
    "The App Store build can detect Ollama but cannot install the app or download models; manage those in Ollama." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version App Store peut détecter Ollama, mais ne peut ni l’installer ni télécharger ses modèles. Gérez ces opérations dans Ollama."
          }
        }
      }
    },
    "OpenAI and Anthropic receive the generation prompt, relevant syllabus context, and draft assessment data when selected." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous les sélectionnez, OpenAI et Anthropic reçoivent les instructions de génération, les éléments utiles du programme et les données du sujet en cours de rédaction."
          }
        }
      }
    },
    "API keys are stored in Keychain. Hosted generation remains blocked until you accept the disclosure." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés API sont enregistrées dans le Trousseau. La génération en ligne reste bloquée jusqu’à votre accord sur les données transmises."
          }
        }
      }
    },
    "Ollama is unavailable" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ollama est indisponible"
          }
        }
      }
    },
    "Open Ollama, wait for it to start, then choose AI > Check Ollama Status." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez Ollama, attendez son démarrage, puis choisissez IA > Vérifier l’état d’Ollama."
          }
        }
      }
    },
    "If a model is missing, download the exact recommended tag shown in AI Settings and check again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si un modèle manque, téléchargez la version exacte recommandée dans les réglages IA, puis vérifiez à nouveau."
          }
        }
      }
    },
    "If generation repeatedly fails, keep enough free memory, stop other model workloads, and copy diagnostics before reporting the issue." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la génération échoue plusieurs fois, libérez de la mémoire, arrêtez les autres tâches utilisant des modèles et copiez le diagnostic avant de signaler le problème."
          }
        }
      }
    },
    "A paper fails validation" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un sujet échoue à la validation"
          }
        }
      }
    },
    "No partial package is published. The error identifies the failed provider, content, or PDF gate." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun ensemble de fichiers incomplet n’est publié. Le message d’erreur indique le fournisseur ou le contrôle de contenu ou de PDF concerné."
          }
        }
      }
    },
    "Retry once with the recommended model. A different seed creates a new form; changing models can materially change quality." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réessayez une fois avec le modèle recommandé. Une autre graine crée un nouveau sujet. Changer de modèle peut modifier sensiblement la qualité."
          }
        }
      }
    },
    "Use Tools > Show Benchmark to check memory pressure, storage, thermal state, PDF speed, network, and Ollama latency." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Outils > Afficher le test de performances, vérifiez la pression mémoire, le stockage, l’état thermique, la vitesse de création des PDF, le réseau et la latence d’Ollama."
          }
        }
      }
    },
    "Commands" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commandes"
          }
        }
