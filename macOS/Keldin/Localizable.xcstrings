          "stringUnit" : {
            "state" : "translated",
            "value" : "Préparer les références"
          }
        }
      }
    },
    "Approve the one-time download from registered French Ministry sources. Holdout material is excluded from generation." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez le téléchargement ponctuel depuis les sources enregistrées du ministère. Les documents réservés à l’évaluation sont exclus de la génération."
          }
