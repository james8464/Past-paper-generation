        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non relu et non officiel"
          }
        }
      }
    },
    "Automated authoring, solving and verification do not constitute Ministry, examiner or teacher approval. Regenerating or editing any artifact invalidates its recorded review." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La rédaction, la résolution et la vérification automatisées ne constituent pas une approbation du ministère, d’un examinateur ou d’un enseignant. Toute régénération ou modification d’un document invalide l’avis enregistré."
          }
