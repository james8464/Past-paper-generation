    },
    "OpenAI and Anthropic generation sends prompts, selected syllabus context, and draft question content to the provider you choose. API keys stay in Keychain. Ollama keeps generation local." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La génération avec OpenAI ou Anthropic transmet les instructions, les éléments du programme sélectionnés et les questions en cours de rédaction au fournisseur choisi. Les clés API restent dans le Trousseau. Avec Ollama, la génération reste locale."
          }
        }
      }
    },
