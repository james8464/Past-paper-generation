    "Official sources are downloaded with your permission. V34 builds papers on this Mac without model prompts or cloud generation." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sources officielles sont téléchargées avec votre accord. V34 construit les sujets sur ce Mac, sans requête à un modèle ni génération dans le cloud."
          }
        }
      }
    },
    "The reference corpus is incomplete; its presence does not prove topic coverage." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le corpus de référence est incomplet : sa présence ne garantit pas la couverture de tous les thèmes."
          }
        }
      }
    },
    "No French model is yet qualified. Gemma 4 12B is a comparison baseline, not a recommendation." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun modèle n’est encore qualifié pour la NSI. Gemma 4 12B sert de base de comparaison, pas de recommandation."
