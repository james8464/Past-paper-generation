    },
    "Candidate-path reference qualification is insufficient. A structurally valid practice bank is not calibrated or externally qualified." : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "La comparaison des parcours aux références est insuffisante. Une banque d’exercices structurellement valide n’est pas pour autant calibrée ou validée par un tiers." } } }
    },
    "Candidate-path evidence passed." : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les contrôles des parcours sont validés." } } }
    },
    "Candidate-path evidence needs review." : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les éléments de contrôle des parcours doivent être examinés." } } }
    },
    "Candidate-path and focused-bank evidence is not present in this package." : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les éléments de contrôle des parcours et des banques ciblées ne figurent pas dans ce dossier." } } }
    },
    "All content follows reviewed fixed contracts; no AI-authored wording is recorded." : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Tout le contenu suit des définitions fixes examinées. Aucune rédaction par IA n’est enregistrée." } } }
    },
    "The package records AI-authored content; review coverage remains a separate check." : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le dossier contient du contenu rédigé par IA. La couverture de l’examen fait l’objet d’un contrôle distinct." } } }
    },
    "Mixed provenance includes %lld stem edit(s) and reviewed fixed contracts; a stem edit is not full-question authorship." : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "La provenance mixte associe des énoncés modifiés (%lld) à des définitions fixes examinées. Modifier un énoncé ne revient pas à rédiger toute la question." } } }
    },
    "The package records mixed authored and reviewed fixed content." : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le dossier contient à la fois du contenu rédigé et du contenu fixe examiné." } } }
    },
    "The package records built-in or unreviewed content, not reviewed originality." : {
      "localizations" : { "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le dossier contient du contenu intégré ou non examiné, sans validation de son originalité." } } }
    },
    "Authoring provenance is unknown." : {
