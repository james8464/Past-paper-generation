      }
    },
    "Choose a local Ollama model first." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez d’abord un modèle Ollama local."
          }
        }
      }
    },
    "Create a non-official practice paper with indicative marking guidance." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créer un sujet d'entraînement non officiel avec un barème indicatif."
