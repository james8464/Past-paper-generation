  "topics": [
    {
      "id": "pure-proof",
      "title": "proof",
      "points": [
        "construct a deductive mathematical argument",
        "use proof by contradiction",
        "disprove a statement with a counterexample",
        "use precise implication and equivalence notation"
      ],
      "papers": ["1", "2", "3"]
    },
    {
      "id": "pure-algebra-functions",
      "title": "algebra and functions",
      "points": [
        "manipulate algebraic expressions and surds exactly",
        "solve equations and inequalities",
        "compose and invert functions with stated domains",
        "use partial fractions and the factor theorem"
      ],
      "papers": ["1", "2", "3"]
    },
    {
      "id": "pure-coordinate-geometry",
      "title": "coordinate geometry",
      "points": [
        "use straight-line equations and gradients",
        "derive and use equations of circles",
        "apply parametric equations to curves",
        "find intersections and tangents algebraically"
      ],
      "papers": ["1", "2", "3"]
    },
    {
      "id": "pure-sequences-series",
      "title": "sequences and series",
      "points": [
        "use arithmetic and geometric series",
        "apply sigma notation",
        "expand binomial expressions",
        "model a process with a recurrence relation"
      ],
      "papers": ["1", "2", "3"]
    },
    {
      "id": "pure-trigonometry",
      "title": "trigonometry",
      "points": [
        "use radians and arc-length relationships",
        "solve trigonometric equations in a stated interval",
        "prove and apply trigonometric identities",
        "use inverse functions with appropriate domains"
      ],
      "papers": ["1", "2", "3"]
    },
    {
      "id": "pure-exponentials-logarithms",
      "title": "exponentials and logarithms",
      "points": [
        "apply logarithm laws",
        "solve exponential equations",
        "use exponential growth and decay models",
        "linearise a relationship using logarithms"
      ],
      "papers": ["1", "2", "3"]
    },
    {
      "id": "pure-differentiation",
      "title": "differentiation",
      "points": [
        "differentiate standard and composite functions",
        "use product, quotient and chain rules",
        "apply derivatives to rates of change and optimisation",
        "use implicit and parametric differentiation"
      ],
      "papers": ["1", "2", "3"]
    },
    {
      "id": "pure-integration",
      "title": "integration",
      "points": [
        "integrate standard functions",
        "use substitution and integration by parts",
        "solve a separable differential equation",
        "interpret a definite integral geometrically"
      ],
      "papers": ["1", "2", "3"]
    },
    {
      "id": "pure-numerical-methods",
      "title": "numerical methods",
      "points": [
        "locate a root by a sign change",
        "apply fixed-point iteration",
        "apply the Newton-Raphson method",
        "justify convergence and interpret numerical error"
      ],
      "papers": ["1", "2", "3"]
    },
    {
      "id": "mechanics-vectors",
      "title": "vectors",
      "points": [
        "use two-dimensional and three-dimensional vectors",
        "resolve a vector into components",
        "find magnitudes and directions",
        "apply vectors to position, force and motion"
      ],
      "papers": ["2"]
    },
    {
      "id": "mechanics-quantities-units",
      "title": "quantities and units in mechanics",
      "points": [
        "use SI base and derived units",
        "distinguish scalar and vector quantities",
        "check dimensional consistency",
        "interpret a mathematical model in context"
      ],
      "papers": ["2"]
    },
    {
      "id": "mechanics-kinematics",
      "title": "kinematics",
      "points": [
        "use displacement velocity and acceleration",
        "apply constant-acceleration formulae",
        "interpret displacement-time and velocity-time graphs",
        "model motion under gravity"
      ],
      "papers": ["2"]
    },
    {
      "id": "mechanics-forces-newton",
      "title": "forces and Newton's laws",
      "points": [
        "draw and use a force diagram",
        "apply Newton's laws to connected particles",
        "model friction and normal reaction",
        "resolve forces on an inclined plane"
      ],
      "papers": ["2"]
    },
    {
      "id": "mechanics-moments",
      "title": "moments",
      "points": [
        "calculate a moment about a point",
        "apply equilibrium conditions",
        "model a rigid body with a centre of mass",
        "interpret reaction forces in context"
      ],
      "papers": ["2"]
    },
    {
      "id": "statistics-sampling",
      "title": "statistical sampling",
      "points": [
        "distinguish a population from a sample",
        "compare sampling methods",
        "identify sources of sampling bias",
        "interpret a sampling frame"
      ],
      "papers": ["3"]
    },
    {
      "id": "statistics-data-presentation",
      "title": "data presentation and interpretation",
      "points": [
        "calculate and interpret summary statistics",
        "use histograms and cumulative-frequency diagrams",
        "interpret correlation without inferring causation",
        "identify outliers and compare distributions"
      ],
      "papers": ["3"]
    },
    {
      "id": "statistics-probability",
      "title": "probability",
      "points": [
        "use conditional probability",
        "apply set notation and probability laws",
        "use tree diagrams and independent events",
        "model discrete outcomes"
      ],
      "papers": ["3"]
    },
    {
      "id": "statistics-distributions",
      "title": "statistical distributions",
      "points": [
        "use a binomial distribution",
        "use a normal distribution",
        "select and justify a probability model",
        "apply a continuity correction where appropriate"
      ],
      "papers": ["3"]
    },
    {
      "id": "statistics-hypothesis-testing",
      "title": "statistical hypothesis testing",
      "points": [
        "state null and alternative hypotheses",
        "calculate a critical region or p-value",
        "make a conclusion in context",
        "interpret the significance level and possible error"
      ],
      "papers": ["3"]
    }
  ],
