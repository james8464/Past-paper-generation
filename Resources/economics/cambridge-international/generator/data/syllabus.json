  "topics": [
    {
      "id": "as-basic-economic-ideas",
      "title": "basic economic ideas and resource allocation",
      "points": [
        "scarcity creates an opportunity cost",
        "factors of production have alternative uses",
        "specialisation can raise productivity",
        "resource allocation involves choices at the margin"
      ],
      "papers": ["1", "2"]
    },
    {
      "id": "as-price-system",
      "title": "the price system and the microeconomy",
      "points": [
        "demand responds to price and non-price determinants",
        "supply reflects costs and productive conditions",
        "elasticity influences revenue and incidence",
        "consumer and producer surplus measure welfare"
      ],
      "papers": ["1", "2"]
    },
    {
      "id": "as-government-micro",
      "title": "government microeconomic intervention",
      "points": [
        "externalities create a divergence between private and social costs",
        "indirect taxes alter incentives and market outcomes",
        "subsidies can encourage consumption or production",
        "regulation may address information or market-power failures"
      ],
      "papers": ["1", "2"]
    },
    {
      "id": "as-macroeconomy",
      "title": "the macroeconomy",
      "points": [
        "aggregate demand affects output and the price level",
        "inflation changes real incomes and competitiveness",
        "unemployment has cyclical and structural causes",
        "the current account records international transactions"
      ],
      "papers": ["1", "2"]
    },
    {
      "id": "a-level-market-structure",
      "title": "market structures and business behaviour",
      "points": [
        "market structure changes pricing power",
        "marginal analysis informs profit-maximising output",
        "contestability depends on entry and exit conditions",
        "price discrimination affects consumers and producers"
      ],
      "papers": ["3", "4"]
    },
    {
      "id": "a-level-labour-market",
      "title": "the labour market",
      "points": [
        "labour demand is derived from marginal revenue product",
        "wage differentials can reflect skills and market power",
        "monopsony may reduce wages and employment",
        "trade unions can alter bargaining outcomes"
      ],
      "papers": ["3", "4"]
    },
    {
      "id": "a-level-growth-development",
      "title": "economic growth and development",
      "points": [
        "growth and development measure different outcomes",
        "human capital can increase productive potential",
        "inequality may affect opportunity and welfare",
        "institutions influence investment and development"
      ],
      "papers": ["3", "4"]
    },
    {
      "id": "a-level-policy",
      "title": "macroeconomic policy",
      "points": [
        "fiscal policy changes demand and incentives",
        "monetary policy affects credit and exchange rates",
        "supply-side policy targets productive capacity",
        "policy objectives may conflict over different time periods"
      ],
      "papers": ["3", "4"]
    }
  ],
